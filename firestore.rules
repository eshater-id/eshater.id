rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Default deny
    match /{document=**} {
      allow read, write: if false;
    }

    // Helper functions
    function isSignedIn() {
      return request.auth != null;
    }

    function isEmailVerified() {
      return isSignedIn() && request.auth.token.email_verified == true;
    }

    function isAdmin() {
      return isSignedIn() && exists(/databases/$(database)/documents/admins/$(request.auth.uid));
    }

    function isValidId(id) {
      return id is string && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    // Member Validation
    function isValidMember(data) {
      return data.fullName is string && data.fullName.size() >= 2 && data.fullName.size() <= 100 &&
             data.email is string && data.email.matches('^[^@]+@[^@]+\\.[^@]+$') &&
             data.phone is string && data.phone.size() >= 8 && data.phone.size() <= 20 &&
             data.status in ['pending', 'approved', 'rejected'] &&
             data.createdAt == request.time;
    }

    // Members Collection
    match /members/{memberId} {
      allow create: if isValidId(memberId) && isValidMember(request.resource.data) && request.resource.data.status == 'pending';
      allow get: if isAdmin() || (isSignedIn() && request.auth.token.email == resource.data.email);
      allow list: if isAdmin();
      allow update: if isAdmin() && 
                    request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status', 'updatedAt']) &&
                    request.resource.data.status in ['pending', 'approved', 'rejected'] &&
                    request.resource.data.updatedAt == request.time;
      allow delete: if isAdmin();
    }

    // Admins Collection (Strictly controlled)
    match /admins/{adminId} {
      allow read: if isSignedIn(); // Allow checking if user is admin
      allow write: if false; // Admins must be added via Console or special script
    }
  }
}
